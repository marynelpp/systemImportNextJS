# URL pública cuando exista dominio; localhost se usa durante desarrollo.
APP_URL=http://localhost:3000

# SQL Server: llenar solo en .env.local, nunca en este archivo.
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

# Azure Blob: la cadena real solo va en .env.local. Contenedor privado para imágenes.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_PRODUCT_IMAGES_CONTAINER=archivos
